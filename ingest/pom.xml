<?xml version="1.0" encoding="UTF-8"?>
<!--
  Ingest — HL7 IG Bundle Normalizer
  ═════════════════════════════════════

  Java tool that converts HL7 IG-publisher output bundles into AsciiDoc
  topic fragments placed under
  topics/src/main/asciidoc/topics/ext/standards/{ig-package-id}/.

  Status: skeleton — first real run will be on US Core.

  Invocation (see README and ingest module javadoc for full options).

  Output fragments require post-processing — run the semantic-linebreak
  normalizer (see IKE-INGEST.md §"Step 2") before committing.
-->
<project xmlns="http://maven.apache.org/POM/4.1.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.1.0
         http://maven.apache.org/xsd/maven-4.1.0.xsd">
    <modelVersion>4.1.0</modelVersion>

    <parent>
        <groupId>network.ike.examples</groupId>
        <artifactId>hl7-ig-corpus-example</artifactId>
    </parent>

    <artifactId>ingest</artifactId>
    <packaging>jar</packaging>

    <name>HL7 IG Bundle Ingester</name>
    <description>
        Java tool that converts HL7 IG-publisher output bundles into
        AsciiDoc topic fragments for ingestion into the corpus topic
        library.
    </description>

    <properties>
        <exec.mainClass>network.ike.examples.hl7ig.ingest.FhirPackageIngester</exec.mainClass>
    </properties>

    <dependencies>
        <!-- Cross-cutting ingest infrastructure: TarballDownloader,
             TopicFragmentWriter, RegistryShardWriter, IncludesFileWriter,
             provenance attribute helpers. -->
        <dependency>
            <groupId>network.ike.docs</groupId>
            <artifactId>ike-doc-ingest</artifactId>
            <version>${network.ike.docs__GA__ike-docs__VERSION}</version>
        </dependency>

        <!-- JSON parsing for FHIR resources. Stays local — the library
             intentionally doesn't impose a JSON binding on consumers. -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.18.2</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <mainClass>${exec.mainClass}</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
