<?xml version="1.0" encoding="UTF-8"?>
<!--
  Da Vinci DEQM — Per-IG Reconstruction Assembly
  ══════════════════════════════════════════════════

  Reconstructs the Da Vinci Data Exchange for Quality Measures (DEQM)
  implementation guide as one document from the topics emitted by
  the ingest module into
  topics/src/docs/asciidoc/network.ike.examples/ext/standards/us-davinci-deqm/.

  Build:
    mvn clean verify -Dike.pdf.prawn    # Prawn PDF
    mvn clean verify                    # HTML only
-->
<project xmlns="http://maven.apache.org/POM/4.1.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.1.0
         http://maven.apache.org/xsd/maven-4.1.0.xsd">
    <modelVersion>4.1.0</modelVersion>

    <parent>
        <groupId>network.ike.examples</groupId>
        <artifactId>hl7-ig-corpus-example</artifactId>
    </parent>

    <artifactId>us-davinci-deqm</artifactId>
    <packaging>pom</packaging>

    <name>Da Vinci DEQM (per-IG assembly)</name>
    <description>
        Per-IG reconstruction of the Da Vinci Data Exchange for
        Quality Measures (DEQM) HL7 implementation guide from
        ingested topic fragments.
    </description>

    <properties>
        <pdf.source.document>us-davinci-deqm</pdf.source.document>
        <!-- Renderers on by default, as the ike-platform source sets them. Published
             ike-platform POMs from 185 on carry these flags baked to true
             (IKE-Network/ike-issues#1167: Maven 4.0.0-rc-7 writes the release build's
             active-profile values into the consumer POM). Remove this block once
             ike-parent is released on Maven 4.0.0 GA, which carries the fix
             (apache/maven#13761). A command-line -Dike.skip.* still overrides these. -->
        <ike.skip.html>false</ike.skip.html>
        <ike.skip.html-single>false</ike.skip.html-single>
        <ike.skip.prince>false</ike.skip.prince>
        <ike.skip.pdf-default>false</ike.skip.pdf-default>
    </properties>

    <dependencies>
        <dependency>
            <groupId>network.ike.examples</groupId>
            <artifactId>topics</artifactId>
            <version>${project.version}</version>
            <classifier>adoc</classifier>
            <type>zip</type>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.asciidoctor</groupId>
                <artifactId>asciidoctor-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
